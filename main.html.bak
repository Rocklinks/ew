<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Sathya Menu</title>
<link rel="icon" type="image/webp" href="https://www.sathya.store/favicon.webp">
<style>
:root{
  --bg:#eceff7;--ink:#1c2140;--mute:#6b7191;
  --acc:#7c5cff;--acc2:#4f8cff;
  --dk:#1a1f4a;--dk2:#2d2a73;
  --sd:#bcc3da;--sl:#ffffff;
  --raised:10px 10px 22px var(--sd),-10px -10px 22px var(--sl);
  --raised-sm:5px 5px 12px var(--sd),-5px -5px 12px var(--sl);
  --inset:inset 5px 5px 11px var(--sd),inset -5px -5px 11px var(--sl);
  box-sizing:border-box;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){--bg:#1a1d2e;--ink:#e9ecfa;--mute:#8e95b5;--sd:#0f1120;--sl:#272b44;--dk:#12142b;--dk2:#1f1f52}
}
:root[data-theme="dark"]{--bg:#1a1d2e;--ink:#e9ecfa;--mute:#8e95b5;--sd:#0f1120;--sl:#272b44;--dk:#12142b;--dk2:#1f1f52}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{
  margin:0;min-height:100vh;background:var(--bg);color:var(--ink);
  font:16px/1.4 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;font-weight:500;
  padding:env(safe-area-inset-top,0px) 0 env(safe-area-inset-bottom,0px);
}
main{max-width:760px;margin:0 auto;padding:0 20px 56px}

/* HERO */
.hero{
  position:relative;overflow:hidden;
  margin:0 -20px 34px;padding:44px 28px 54px;
  background:linear-gradient(135deg,var(--dk) 0%,var(--dk2) 100%);
  color:#fff;border-radius:0 0 34px 34px;
  box-shadow:0 18px 38px rgba(20,28,42,.35);
}
.hero::before,.hero::after{content:"";position:absolute;border-radius:50%;pointer-events:none}
.hero::before{width:300px;height:300px;right:-80px;top:-100px;background:radial-gradient(circle,rgba(124,92,255,.7),rgba(124,92,255,0) 70%)}
.hero::after{width:260px;height:260px;left:-70px;bottom:-130px;background:radial-gradient(circle,rgba(20,200,170,.45),rgba(20,200,170,0) 70%)}
.brand{display:flex;align-items:center;gap:14px;position:relative;z-index:1}
.mark{
  width:46px;height:46px;border-radius:15px;display:grid;place-items:center;
  background:linear-gradient(145deg,#8b6cff,#14c8aa);
  box-shadow:0 8px 18px rgba(124,92,255,.5),inset 2px 2px 4px rgba(255,255,255,.35);
}
.brand small{display:block;font-size:.68rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.6)}
.brand b{font-size:1.15rem;font-weight:800;letter-spacing:.3px}
.hero h1{position:relative;z-index:1;margin:30px 0 8px;font-size:clamp(2rem,7vw,2.8rem);line-height:1.05;letter-spacing:-.03em;font-weight:800}
.hero h1 span{background:linear-gradient(90deg,#a99bff,#3fe0c5);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p{position:relative;z-index:1;margin:0;color:rgba(255,255,255,.7);font-size:.95rem;max-width:34ch}
.date{
  position:relative;z-index:1;display:inline-block;margin-top:20px;
  padding:6px 14px;border-radius:999px;font-size:.72rem;font-weight:700;letter-spacing:.6px;
  background:rgba(255,255,255,.08);color:#fff;
  box-shadow:inset 2px 2px 5px rgba(0,0,0,.3),inset -2px -2px 5px rgba(255,255,255,.06);
}

/* GRID */
.grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:24px}
@media(max-width:560px){.grid{grid-template-columns:1fr;gap:20px}}

.tile{
  position:relative;display:flex;flex-direction:column;gap:18px;height:100%;
  padding:24px 22px 22px;border-radius:26px;background:var(--bg);color:inherit;text-decoration:none;
  box-shadow:var(--raised);overflow:hidden;
  transition:transform .25s ease,box-shadow .25s ease;
  animation:rise .55s cubic-bezier(.2,.8,.2,1) both;
}
.grid li:nth-child(1) .tile{animation-delay:.05s}
.grid li:nth-child(2) .tile{animation-delay:.13s}
.grid li:nth-child(3) .tile{animation-delay:.21s}
.grid li:nth-child(4) .tile{animation-delay:.29s}
.grid li{display:block}
/* one color per tile */
.grid li:nth-child(1){--acc:#0fb5a3;--acc2:#2dd4bf}
.grid li:nth-child(2){--acc:#7c5cff;--acc2:#a78bfa}
.grid li:nth-child(3){--acc:#16a34a;--acc2:#4ade80}
.grid li:nth-child(4){--acc:#f59e0b;--acc2:#fb923c}
.tile::before{ /* accent edge */
  content:"";position:absolute;left:0;top:22px;bottom:22px;width:4px;border-radius:0 4px 4px 0;
  background:linear-gradient(180deg,var(--acc2),var(--acc));opacity:.0;transition:opacity .25s ease;
}
.tile:hover{transform:translateY(-4px);box-shadow:14px 16px 28px var(--sd),-10px -10px 22px var(--sl)}
.tile:hover::before{opacity:1}
.tile:active{transform:translateY(0);box-shadow:var(--inset)}
.tile:focus-visible{outline:3px solid var(--acc);outline-offset:4px}

.top{display:flex;align-items:center;justify-content:space-between}
.ico{
  width:58px;height:58px;border-radius:20px;display:grid;place-items:center;color:var(--acc);
  background:var(--bg);box-shadow:var(--inset);transition:.25s ease;
}
.tile:hover .ico{background:linear-gradient(145deg,var(--acc2),var(--acc));color:#fff;box-shadow:0 8px 18px color-mix(in srgb,var(--acc) 45%,transparent)}
.num{font-size:2.4rem;font-weight:800;letter-spacing:-.04em;color:#16a34a;line-height:1;user-select:none}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .num{color:#4ade80}}
:root[data-theme="dark"] .num{color:#4ade80}

.tile h2{margin:0;font-size:1.25rem;font-weight:800;letter-spacing:-.01em}
.tile p{margin:4px 0 0;font-size:.82rem;color:var(--mute);font-weight:600}

.go{
  margin-top:auto;display:flex;align-items:center;justify-content:space-between;
  font-size:.72rem;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;color:var(--acc);
}
.arrow{
  width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:var(--bg);
  box-shadow:var(--raised-sm);transition:transform .25s ease;
}
.tile:hover .arrow{transform:translateX(4px)}
.tile:active .arrow{box-shadow:var(--inset)}

footer{margin-top:40px;text-align:center;font-size:.7rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--mute)}

@keyframes rise{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){
  .tile,.ico,.arrow,.tile::before{transition:none;animation:none}
  .tile:hover{transform:none}
}
</style>
</head>
<body>
<main>

  <header class="hero">
    <div class="brand">
      <div class="mark">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h10M4 18h13" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/></svg>
      </div>
      <div><small>Sathya</small><b>Report Hub</b></div>
    </div>
    <h1>Pick your <span>dashboard</span></h1>
    <p>One place for every sales report. Tap a card to open.</p>
    <span class="date" id="today"></span>
  </header>

  <ul class="grid">
    <li>
      <a class="tile" href="https://ew-mauve.vercel.app/warranty.html" target="_blank" rel="noopener">
        <div class="top">
          <div class="ico">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>
          </div>
          <span class="num">01</span>
        </div>
        <div>
          <h2>Warranty</h2>
          <p>EW% by region, branch &amp; tier</p>
        </div>
        <div class="go"><span>Open</span>
          <span class="arrow"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </div>
      </a>
    </li>

    <li>
      <a class="tile" href="https://ew-mauve.vercel.app/highend.html" target="_blank" rel="noopener">
        <div class="top">
          <div class="ico">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9l4-6z"/><path d="M2 9h20M10 3l-2 6 4 12M14 3l2 6-4 12"/></svg>
          </div>
          <span class="num">02</span>
        </div>
        <div>
          <h2>High End</h2>
          <p>Premium product sales</p>
        </div>
        <div class="go"><span>Open</span>
          <span class="arrow"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </div>
      </a>
    </li>

    <li>
      <a class="tile" href="https://ew-mauve.vercel.app/growth.html" target="_blank" rel="noopener">
        <div class="top">
          <div class="ico">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/></svg>
          </div>
          <span class="num">03</span>
        </div>
        <div>
          <h2>Growth</h2>
          <p>Growth numbers &amp; trends</p>
        </div>
        <div class="go"><span>Open</span>
          <span class="arrow"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </div>
      </a>
    </li>

    <li>
      <a class="tile" href="https://rocklinks.github.io/sathya-review-tracker/" target="_blank" rel="noopener">
        <div class="top">
          <div class="ico">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3z"/></svg>
          </div>
          <span class="num">04</span>
        </div>
        <div>
          <h2>Reviews</h2>
          <p>Review tracker</p>
        </div>
        <div class="go"><span>Open</span>
          <span class="arrow"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </div>
      </a>
    </li>
  </ul>

  <footer>Sathya · Reports</footer>
</main>

<script>
(function(){
  var el=document.getElementById('today');
  try{
    el.textContent=new Date().toLocaleDateString('en-IN',{weekday:'long',day:'numeric',month:'short',year:'numeric'});
  }catch(e){el.style.display='none'}
})();
</script>
</body>
</html>
